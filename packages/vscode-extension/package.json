{
  "name": "design-token-extractor-migrator",
  "displayName": "Design Token Extractor & Migrator",
  "description": "Scans CSS/SCSS/SASS/LESS, Vue, HTML, and JS/TS in a workspace (including Tailwind arbitrary values and CSS-in-JS), extracts design tokens, generates a token system, flags contrast issues, and offers preview/apply replacement of hardcoded values.",
  "version": "0.5.0",
  "publisher": "bobrowsse-tech",
  "license": "MIT",
  "icon": "images/icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "keywords": [
    "design tokens",
    "css",
    "scss",
    "design system",
    "dtcg",
    "tokens studio"
  ],
  "categories": [
    "Linters",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bobrowsse-tech/design-token-extractor"
  },
  "homepage": "https://github.com/bobrowsse-tech/design-token-extractor",
  "bugs": {
    "url": "https://github.com/bobrowsse-tech/design-token-extractor/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:less",
    "onLanguage:vue",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "designTokens.scanWorkspace",
        "title": "Design Tokens: Scan Workspace"
      },
      {
        "command": "designTokens.generateTokenFiles",
        "title": "Design Tokens: Generate Token Files"
      },
      {
        "command": "designTokens.previewMigration",
        "title": "Design Tokens: Preview Migration"
      },
      {
        "command": "designTokens.applyMigration",
        "title": "Design Tokens: Apply Migration"
      },
      {
        "command": "designTokens.undoMigration",
        "title": "Design Tokens: Undo Last Migration"
      },
      {
        "command": "designTokens.renameToken",
        "title": "Design Tokens: Rename Token"
      },
      {
        "command": "designTokens.reviewClusters",
        "title": "Design Tokens: Review Clusters"
      },
      {
        "command": "designTokens.mapSemantics",
        "title": "Design Tokens: Map Semantic Alias"
      },
      {
        "command": "designTokens.undoHistory",
        "title": "Design Tokens: Undo From History"
      }
    ],
    "configuration": {
      "title": "Design Tokens",
      "properties": {
        "designTokens.include": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "**/*.css",
            "**/*.scss",
            "**/*.sass",
            "**/*.less",
            "**/*.vue",
            "**/*.html",
            "**/*.htm",
            "**/*.js",
            "**/*.jsx",
            "**/*.ts",
            "**/*.tsx"
          ],
          "description": "Glob patterns to scan."
        },
        "designTokens.exclude": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/*.min.css"],
          "description": "Glob patterns to skip."
        },
        "designTokens.outputDir": {
          "type": "string",
          "default": "design-tokens",
          "description": "Where generated token files are written, relative to workspace root."
        },
        "designTokens.naming.case": {
          "type": "string",
          "enum": ["kebab", "camel", "pascal", "snake"],
          "default": "kebab",
          "description": "Naming convention for generated token names."
        },
        "designTokens.naming.prefix": {
          "type": "string",
          "default": "",
          "description": "Optional prefix for every generated token name."
        },
        "designTokens.clustering.colorDeltaE": {
          "type": "number",
          "default": 2.0,
          "minimum": 0,
          "description": "Perceptual color distance threshold for flagging near-duplicate colors. Higher = more colors get flagged as related. Never auto-merges regardless of this value."
        },
        "designTokens.clustering.spacingToleranceRem": {
          "type": "number",
          "default": 0.01,
          "minimum": 0,
          "description": "Rem tolerance for flagging near-duplicate spacing/radius values."
        },
        "designTokens.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline 'N other places use this value' hints."
        },
        "designTokens.theme.darkMarkers": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "[data-theme=dark]",
            "[data-theme=\"dark\"]",
            "[data-mode=dark]",
            "[data-color-mode=dark]",
            "[data-bs-theme=dark]",
            ".dark",
            ".dark-mode",
            ".theme-dark",
            ".night",
            ".prefers-dark",
            "prefers-color-scheme: dark"
          ],
          "description": "Selector fragments that mark a dark-theme variant for pairing."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".designtokenrc.json",
        "url": "./schemas/designtokenrc.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "rm -rf out && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package --no-dependencies -o design-token-extractor-migrator.vsix"
  },
  "dependencies": {
    "@design-token-extractor/core": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "ovsx": "^1.1.1",
    "typescript": "^6.0.3"
  }
}
