    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bobrowsse-tech/design-token-extractor.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bobrowsse-tech/design-token-extractor",
